<?xml version="1.0" encoding="UTF-8" ?>
<robot name="six_dof_arm">
  <!-- Materials -->
  <material name="blue">
    <color rgba="0 0 0.8 1" />
  </material>
  <material name="red">
    <color rgba="0.8 0 0 1" />
  </material>
  <material name="green">
    <color rgba="0 0.8 0 1" />
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <inertial>
      <mass value="5.0" />
      <origin xyz="0 0 0.05" />
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.05" />
      <geometry>
        <box size="0.2 0.2 0.1" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.05" />
      <geometry>
        <box size="0.2 0.2 0.1" />
      </geometry>
    </collision>
  </link>

  <!-- Shoulder Link -->
  <link name="shoulder_link">
    <inertial>
      <mass value="2.0" />
      <origin xyz="0 0 0.1" />
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.1" />
      <geometry>
        <cylinder radius="0.05" length="0.2" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0.1" />
      <geometry>
        <cylinder radius="0.05" length="0.2" />
      </geometry>
    </collision>
  </link>

  <!-- Upper Arm Link -->
  <link name="upper_arm_link">
    <inertial>
      <mass value="3.0" />
      <origin xyz="0 0 0.2" />
      <inertia ixx="0.05" ixy="0" ixz="0" iyy="0.05" iyz="0" izz="0.02" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.2" />
      <geometry>
        <cylinder radius="0.04" length="0.4" />
      </geometry>
      <material name="green" />
    </visual>
    <collision>
      <origin xyz="0 0 0.2" />
      <geometry>
        <cylinder radius="0.04" length="0.4" />
      </geometry>
    </collision>
  </link>

  <!-- Forearm Link -->
  <link name="forearm_link">
    <inertial>
      <mass value="2.0" />
      <origin xyz="0 0 0.175" />
      <inertia ixx="0.03" ixy="0" ixz="0" iyy="0.03" iyz="0" izz="0.01" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.175" />
      <geometry>
        <cylinder radius="0.03" length="0.35" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.175" />
      <geometry>
        <cylinder radius="0.03" length="0.35" />
      </geometry>
    </collision>
  </link>

  <!-- Wrist 1 Link -->
  <link name="wrist_1_link">
    <inertial>
      <mass value="0.5" />
      <origin xyz="0 0 0.025" />
      <inertia ixx="0.002" ixy="0" ixz="0" iyy="0.002" iyz="0" izz="0.002" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.025" />
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
      <material name="red" />
    </visual>
    <collision>
      <origin xyz="0 0 0.025" />
      <geometry>
        <box size="0.05 0.05 0.05" />
      </geometry>
    </collision>
  </link>

  <!-- Wrist 2 Link -->
  <link name="wrist_2_link">
    <inertial>
      <mass value="0.3" />
      <origin xyz="0 0 0.04" />
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" />
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
      <material name="green" />
    </visual>
    <collision>
      <origin xyz="0 0 0.04" />
      <geometry>
        <box size="0.04 0.04 0.04" />
      </geometry>
    </collision>
  </link>

  <!-- Wrist 3 Link (End Effector) -->
  <link name="wrist_3_link">
    <inertial>
      <mass value="0.2" />
      <origin xyz="0 0 0.04" />
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.04" />
      <geometry>
        <box size="0.03 0.03 0.03" />
      </geometry>
      <material name="blue" />
    </visual>
    <collision>
      <origin xyz="0 0 0.04" />
      <geometry>
        <box size="0.03 0.03 0.03" />
      </geometry>
    </collision>
  </link>

  <!-- Joint Definitions -->
  <joint name="joint_1" type="revolute">
    <parent link="base_link" />
    <child link="shoulder_link" />
    <origin xyz="0 0 0.1" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="150.0" velocity="3.15" />
  </joint>

  <joint name="joint_2" type="revolute">
    <parent link="shoulder_link" />
    <child link="upper_arm_link" />
    <origin xyz="0 0.1 0.2" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0944" upper="2.0944" effort="150.0" velocity="3.15" />
  </joint>

  <joint name="joint_3" type="revolute">
    <parent link="upper_arm_link" />
    <child link="forearm_link" />
    <origin xyz="0 0 0.4" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.618" upper="2.618" effort="150.0" velocity="3.15" />
  </joint>

  <joint name="joint_4" type="revolute">
    <parent link="forearm_link" />
    <child link="wrist_1_link" />
    <origin xyz="0 0 0.35" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-3.1416" upper="3.1416" effort="50.0" velocity="3.2" />
  </joint>

  <joint name="joint_5" type="revolute">
    <parent link="wrist_1_link" />
    <child link="wrist_2_link" />
    <origin xyz="0 0.05 0.1" rpy="0 0 0" />
    <axis xyz="0 1 0" />
    <limit lower="-2.0944" upper="2.0944" effort="50.0" velocity="3.2" />
  </joint>

  <joint name="joint_6" type="revolute">
    <parent link="wrist_2_link" />
    <child link="wrist_3_link" />
    <origin xyz="0 0 0.08" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-6.2832" upper="6.2832" effort="50.0" velocity="3.2" />
  </joint>
</robot>
